{
  "title": "Lab Mesh VPN — Underlay BGP y Overlay",
  "uid": "lab-mesh",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "tp4"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Estado de sesiones BGP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "expr": "frr_bgp_peer_state",
          "legendFormat": "{{router}} → {{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDA",
                  "color": "red"
                },
                "1": {
                  "text": "ESTABLISHED",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Estado BGP en el tiempo (failover)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "frr_bgp_peer_state",
          "legendFormat": "{{router}} → {{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Prefijos recibidos por peer",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "frr_bgp_peer_prefixes_received_count_total",
          "legendFormat": "{{router}} → {{peer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime de sesión BGP",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "frr_bgp_peer_uptime_seconds",
          "legendFormat": "{{router}} → {{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Mensajes BGP recibidos (tasa)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(frr_bgp_peer_message_received_total[1m])",
          "legendFormat": "{{router}} → {{peer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Targets de monitoreo (up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 7,
      "title": "Headscale — goroutines y memoria",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "go_goroutines{job=\"headscale\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ]
    }
  ]
}